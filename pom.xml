                                    <include>reference/tools.md</include>
                                </includes>
                            </section>
                            <section>
                                <title>Appendix — Vulnerability Data Sources</title>
                                <includes>
                                    <include>workshop/cve-propagation/07-sources.md</include>
                                </includes>
                            </section>
                            <section>
                                <title>Appendix — AI and the Supply Chain</title>
                                <!--
                                    Parked while the AI strand is out of scope for the
