                                    <include>investigations/T02-docker-scout/LESSON.md</include>
                                    <include>investigations/T03-trivy-s01/LESSON.md</include>
                                    <include>investigations/T04-grype-s02/LESSON.md</include>
                                    <include>investigations/T05-pip-audit-s03/LESSON.md</include>
                                    <include>investigations/T06-owasp-dependency-check-s04/LESSON.md</include>
                                    <include>investigations/T07-npm-audit-s05/LESSON.md</include>
                                </includes>
                            </section>
                        </sections>
                    </book>
                </configuration>

