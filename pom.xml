<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.noregressions.trace</groupId>
    <artifactId>manual</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Software Supply Chain Trace Lab Manual</name>

    <!--
        The canonical home for "where does this project live". Declaring it
        here gives the build ${project.scm.url}, which the book's repoUrl var
        below is filled from, so the URL is written down once.

        If you would rather derive it from the actual git remote than declare
        it, git-commit-id-maven-plugin exposes ${git.remote.origin.url} — but
        that needs a .git directory at build time, and the book has to build
        from a source export too.
    -->
    <scm>
        <url>https://github.com/noregressions/ydkwys</url>
        <connection>scm:git:https://github.com/noregressions/ydkwys.git</connection>
        <developerConnection>scm:git:git@github.com:noregressions/ydkwys.git</developerConnection>
    </scm>


    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    </properties>



    <build>
        <plugins>
            <plugin>
                <groupId>dev.noregressions.paperband</groupId>
                <artifactId>paperband-maven-plugin</artifactId>
                <version>0.1.2</version>

                <!--
                    Shared by every goal: what the book is, and how it renders.
                    Both executions below read this, and so does an ad-hoc
                    `mvn paperband:structure` — which then describes exactly the
                    book the PDF and site are built from.
                -->
                <configuration>
                    <!--
                        The book's own pieces live at the conventional home,
                        src/main/paperband/: layouts/ carries the page
                        header/footer templates and the diagnostics page,
                        assets/ the cover image. Content stays scattered
                        across the repo (setup/, workshop/, scenarios/, ...)
                        and is selected by the <sections> globs below,
                        which resolve against the <book><root> declared in
                        each book.
                    -->
                    <theme>noregressions</theme>
                    <!--
                        The kind layer: scenario walkthroughs and tool
                        investigations get distinct identity furniture (badge,
                        title rule, section markers, command fences) on top of
                        the theme. The axis that drives it is declared inside
                        each <book> below.
                    -->
                    <stylesheets>
                        <stylesheet>src/main/paperband/styles/kind.css</stylesheet>
                        <stylesheet>src/main/paperband/styles/diagrams.css</stylesheet>
                        <stylesheet>src/main/paperband/styles/fences.css</stylesheet>
                        <stylesheet>src/main/paperband/styles/command-output.css</stylesheet>
                        <stylesheet>src/main/paperband/styles/screen.css</stylesheet>
                    </stylesheets>
                    <!--
                        US Letter, with real margins: Chromium draws the
                        header/footer templates inside the page margin, so a
                        full-bleed margin of 0 would make them invisible.
                    -->
                    <pageSize>letter</pageSize>
                    <!--
                    <margins>14 12</margins>
                    -->
                    <book>
                        <!--
                            Content lives scattered across the repo (setup/,
                            workshop/, scenarios/, ...), so the patterns in
                            <sections> below resolve against the module
                            basedir. Declared, not inferred: an undeclared
                            <root> now follows the same convention as every
                            other way of naming a book and lands on the book
                            home, src/main/paperband/ — which holds only
                            layouts/, styles/ and assets/, and no cards.
                        -->
                        <root>${project.basedir}</root>

                        <index>auto</index>
                        <cover>
                            <!-- Relative to the book home, src/main/paperband/. -->
                            <image>assets/kcdc2026-cover.jpeg</image>
                            <fullPage>true</fullPage>
                            </cover>
                        <title>You Don't Know What You're Shipping</title>
                        <header>
                            <template>page-header</template>
                        </header>
                        <footer>
                            <template>page-footer</template>
                        </footer>
                        <!--
                            Static-site navigator: a sidebar listing every section and
                            the cards under it. Opt-in, and worth having at 21 cards —
                            it also fills the left of a wide window, which the
                            twelve-section top nav alone does not.

                            An element of <book>, not a var: the vars spelling
                            (<vars><sidebar>true</sidebar></vars>) is the older API and a
                            POM book never reaches the fallback that still honours it in
                            yaml, so it silently produced no sidebar at all. Declaring the
                            element is the opt-in; add <sectionsCollapsed>false</sectionsCollapsed>
                            to ship every section expanded rather than click-to-open.
                        -->
                        <sidebar/>
                        <vars>
                            <subtitle>Workshop</subtitle>
                            <!--
                                Filled from <scm><url> above; reference in a card as
                                {{ vars.repoUrl }}.

                                One hard limit: vars expand in prose only, never in
                                code — not in a fence, not in an inline span. That is
                                correct rather than a bug, because the book contains
                                Docker format strings like {{.Id}} that must survive
                                verbatim. A `git clone` line therefore cannot be
                                templated, and setup/01 getting-started.md and
                                setup/BUILD-MANUAL.md have to carry the URL literally.

                                So those two clone lines are the only places the URL
                                is written out by hand. If the repository ever moves,
                                grep for the old name: the POM value above and those two
                                lines are all there is to change.
                            -->
                            <repoUrl>${project.scm.url}</repoUrl>
                            <!--
                            <authors><author>Steve Poole</author>
                                <author>Brian Vermeer</author></authors>
                            -->
                            <!-- Mermaid diagrams in the greyscale that matches
                                 the noregressions ink/grey system; colour in
                                 this book is semantic, and diagrams aren't. -->
                            <mermaidTheme>neutral</mermaidTheme>
                        </vars>
                        <!--
                            The kind axis: is this card a scenario walkthrough
                            (build and trace) or a tool investigation (point an
                            instrument at a boundary)? Valued per folder by
                            scenarios/paperband.yaml and
                            investigations/paperband.yaml, so cards need no
                            frontmatter of their own; workshop/ and setup/
                            cards have no kind and keep the plain theme voice.
                            Styling lives in the kind.css stylesheet above.
                        -->
                        <axes>
                            <axis>
                                <name>kind</name>
                                <title>Kind</title>
                                <!-- Label-only: classes, badges and site
                                     landing pages, but no divider pages —
                                     the Parts and appendices are the book's
                                     structure, not the kinds. -->
                                <dividers>false</dividers>
                                <values>
                                    <value>
                                        <id>scenario</id>
                                        <label>Scenario</label>
                                    </value>
                                    <value>
                                        <id>investigation</id>
                                        <label>Investigation</label>
                                    </value>
                                </values>
                            </axis>
                        </axes>
                        <sections>
                            <section>
                                <landingPage>false</landingPage>
                                <title>Welcome</title>
                                <includes>
                                    <include>setup/frontpiece.md</include>
                                </includes>
                            </section>

                            <toc/>

                            <!--
                                The book is the workshop: one section per part, each
                                chapter followed by the labs it uses, then appendices
                                for everything off the timed route. Explicit includes
                                throughout, because order is meaning here and globs
                                sweep. Parts 1 to 6 are the four acts:
                                1-2 identification, 3-4 the data over the top of it,
                                5 deliberate abuse of both, 6 what you do every release.
                            -->
                            <section>
                                <title>Introduction and Setup</title>
