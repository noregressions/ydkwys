                                    <include>workshop/02-identification.md</include>
                                    <include>scenarios/S01-spring-node/LESSON.md</include>
                                    <include>scenarios/S04-maven-plugin-hidden-content/LESSON.md</include>
                                    <include>scenarios/S08-extended-sbom/LESSON.md</include>
                                    <include>scenarios/S05-node-prepack/LESSON.md</include>
                                    <include>scenarios/S03-python-pep517/LESSON.md</include>
                                    <include>scenarios/S02-payara-mvnpm/LESSON.md</include>
                                    <include>investigations/T01-snyk-beyond-sbom/LESSON.md</include>
