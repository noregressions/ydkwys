<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>


  <groupId>dev.noregressions</groupId>
  <artifactId>sbom-plus-maven-plugin</artifactId>
  <packaging>maven-plugin</packaging>
  <name>SBOM+ Maven Plugin</name>
  <version>1.0.0</version>
  <description>
    Maven plugin that produces a CycloneDX SBOM covering everything a build
    actually uses: the resolved project dependency graph, the resolved
    plugin/build-tooling graph (plugins plus their transitive dependencies),
    and BOM imports. Works per module (scan) or once across a whole
    multi-module reactor (scan-aggregate). Output only - no vendor, EOL or
    CVE annotation is performed here.
  </description>
  <url>https://github.com/noregressions/sbom-plus-maven-plugin</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Steve Poole</name>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/noregressions/sbom-plus-maven-plugin.git</connection>
    <developerConnection>scm:git:https://github.com/noregressions/sbom-plus-maven-plugin.git</developerConnection>
    <url>https://github.com/noregressions/sbom-plus-maven-plugin</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <!-- release (not just source/target) so the compiler rejects both
         Java 9+ language syntax (records, var, etc.) AND Java 9+-only JDK
         API usage (List.of, Path.of, String.isBlank, Stream.toList, ...) -
         source/target alone only restricts syntax, not which JDK API
         surface is visible, so it would silently let those calls through
         and only fail at runtime on an actual Java 8 JVM. -->
    <maven.compiler.release>8</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Previously inherited from the vendor-support-scanner parent pom.
         Now that this module builds standalone, they have to live here. -->
    <maven.version>3.9.9</maven.version>
    <maven.resolver.version>1.9.20</maven.resolver.version>
    <junit.version>5.10.2</junit.version>
    <jackson.version>2.22.2</jackson.version>
    <!-- Test-only: validates generated SBOMs against the official CycloneDX
         JSON schema (bundled in the jar, so validation runs offline). Never
         a runtime dependency of the plugin itself. -->
    <cyclonedx.core.version>13.2.0</cyclonedx.core.version>
  </properties>

  <dependencies>
    <!-- JSON serialization for the scan report and the CycloneDX SBOM. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- Mojo API + annotations. "provided" scope for all four Maven-supplied
         artifacts below: the Maven distribution running the build already
         puts its own maven-core/maven-model/maven-artifact/maven-plugin-api
         (plus their transitive maven-settings/maven-model-builder/etc.
         jars) on the plugin's classpath at execution time. Declaring them
         "compile" doesn't break anything, but it's the wrong scope: it
         bundles Maven's own classes into this plugin's dependency set
         (maven-plugin-plugin warns about exactly this - "expected to be in
         provided scope"), which risks classloader conflicts against
         whatever Maven version the user's build is actually running. -->
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>3.13.1</version>
      <scope>provided</scope>
    </dependency>

    <!-- Gives us MavenProject, MavenSession, Plugin/Dependency model objects -->
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-model</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-artifact</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Aether resolver - needed to collect the *transitive* dependencies
         of build plugins, since those live in their own classloader realm
         and are not part of project.getArtifacts(). -->
    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-api</artifactId>
      <version>${maven.resolver.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-util</artifactId>
      <version>${maven.resolver.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.cyclonedx</groupId>
      <artifactId>cyclonedx-core-java</artifactId>
      <version>${cyclonedx.core.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <!-- 3.x is required for out-of-the-box JUnit 5 (Jupiter) support
             via the JUnit Platform, no separate provider dependency needed. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <version>3.13.1</version>
        <configuration>
          <goalPrefix>sbom-plus</goalPrefix>
        </configuration>
        <executions>
          <execution>
            <id>default-descriptor</id>
            <goals>
              <goal>descriptor</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Real end-to-end proof that this plugin generates correct SBOMs:
           no Mockito, no hand-built DependencyNode graphs - each project
           under src/it is a genuine pom.xml, actually resolved by a real,
           forked `mvn` build against Maven Central, running this plugin's
           real "scan" goal. verify.groovy then reads the produced SBOM
           JSON and asserts the expected components are present.
           Runs during `mvn verify` (not `mvn test`), since it needs this
           module's own jar already installed - the standard Maven
           convention for testing a plugin against real sample projects. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-invoker-plugin</artifactId>
        <version>3.7.0</version>
        <dependencies>
          <dependency>
            <!-- Bumped from 4.0.21: that version's bundled ASM can't parse
                 class files compiled by JDK 24/25 (major version 68/69),
                 which breaks verify.groovy with "Unsupported class file
                 major version 69" on any machine running Maven itself under
                 a JDK that new - unrelated to this plugin's own Java 8
                 compile target, which only governs the bytecode THIS
                 plugin's classes are compiled to, not what JDK runs Maven. -->
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy</artifactId>
            <version>4.0.33</version>
          </dependency>
          <dependency>
            <!-- Lets each verify.groovy validate the real generated SBOM
                 against the official CycloneDX 1.5 schema. -->
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-core-java</artifactId>
            <version>${cyclonedx.core.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <projectsDirectory>src/it</projectsDirectory>
          <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
          <postBuildHookScript>verify</postBuildHookScript>
          <streamLogsOnFailures>true</streamLogsOnFailures>
        </configuration>
        <executions>
          <execution>
            <id>integration-test</id>
            <goals>
              <goal>install</goal>
              <goal>run</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- Everything a Maven Central release needs beyond a normal build - sources
       jar, javadoc jar, staging locally instead of deploying remotely, and
       (via JReleaser, run as a second, separate command - see jreleaser.yml)
       GPG signing and the actual Central upload - lives in this profile
       rather than the main <build>. Not activated by default: day-to-day
       `mvn test`/`mvn verify` (including the real, forked src/it integration
       builds above) would otherwise pay the javadoc-generation cost on every
       single build. Activate explicitly for an actual release:

         mvn clean deploy -Prelease          (builds + stages locally, unsigned)
         mvn jreleaser:full-release -Prelease (signs + uploads to Central,
                                              then tags and creates the
                                              GitHub release with changelog)

       If you only want the Central upload without touching GitHub, use
       `mvn jreleaser:deploy -Prelease` instead of full-release.
       See jreleaser.yml (same directory as this pom) for the full release
       config and the environment variables it needs, and RELEASING.md for
       the one-time Central Portal / GPG setup. -->
  <profiles>
    <profile>
      <id>release</id>
      <properties>
        <!-- Redirects the standard `deploy` phase to write here instead of
             a real remote repository (this pom has no <distributionManagement>
             configured at all - JReleaser's own Deploy step is what actually
             talks to Central, not maven-deploy-plugin). -->
        <altDeploymentRepository>local::file:${project.build.directory}/staging-deploy</altDeploymentRepository>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-deploy-plugin</artifactId>
            <version>3.1.4</version>
          </plugin>
          <plugin>
            <!-- Not bound to any lifecycle phase - always invoked
                 explicitly (`mvn jreleaser:full-release -Prelease`), and
                 only after `mvn clean deploy -Prelease` has already staged
                 the jar/sources/javadoc into target/staging-deploy/ above.
                 full-release signs every staged artifact with the GPG key
                 configured in jreleaser.yml (env vars only, never this
                 file or settings.xml), uploads the bundle to the Central
                 Publishing Portal, then tags HEAD and creates the GitHub
                 release. <inherited>false</inherited> is the documented
                 safeguard for multi-module reactors (this module doesn't
                 have a parent right now, but costs nothing to include).
                 1.25.0 is the latest JReleaser as of Aug 2026. -->
            <groupId>org.jreleaser</groupId>
            <artifactId>jreleaser-maven-plugin</artifactId>
            <version>1.25.0</version>
            <inherited>false</inherited>
            <configuration>
              <!-- This pom.xml lives in maven-plugin/, a subdirectory of
                   the vendor-support-scanner repo - the actual .git folder
                   is one level up, at the repo root, not here. Without this,
                   JReleaser fails immediately with "Could not determine git
                   HEAD: repository not found" since it only looks for .git
                   in its basedir by default. -->
              <gitRootSearch>true</gitRootSearch>
              <!-- The maven plugin does NOT auto-discover jreleaser.yml in
                   basedir the way the standalone jreleaser CLI does -
                   confirmed empirically: without this, every section of
                   jreleaser.yml (release/signing/deploy) is silently
                   ignored and `jreleaser:deploy` just logs "Deploying is
                   not enabled. Skipping" instead of doing anything. -->
              <configFile>jreleaser.yml</configFile>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
